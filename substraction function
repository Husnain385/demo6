
#include <iostream>
using namespace std;

// Subtraction function
int subtract(int a, int b) {
    return a - b;
}

int main() {
    int num1, num2;

    cout << "Enter first number: ";
    cin >> num1;

    cout << "Enter second number: ";
    cin >> num2;

    int result = subtract(num1, num2);

    cout << "Subtraction result: " << result << endl;

    return 0;
}
